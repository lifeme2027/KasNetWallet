+        /// <summary>Parses a mnemonic and rejects a bad BIP39 checksum.</summary>
+        /// <exception cref="System.FormatException">Word count, unknown word, or checksum mismatch.</exception>
+        public static Mnemonic ParseValidated(string mnemonic, Wordlist? wordlist = null)
+        {
+            var parsed = new Mnemonic(mnemonic, wordlist);
+            if (!parsed.IsValidChecksum)
+            {
+                throw new FormatException("BIP39 checksum does not match.");
+            }
+
+            return parsed;
+        }
